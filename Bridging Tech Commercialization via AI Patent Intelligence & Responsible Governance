    function computeORMetrics(w) {
      const ttm = (26 - (w.speed - 20) * 0.14 + (w.resilience - 50) * 0.03).toFixed(1);
      const cost = (14.5 + (w.speed * 0.07) + (w.resilience * 0.05) - (w.budget * 0.08)).toFixed(1);
      const resScore = Math.min(99, Math.round(45 + w.resilience * 0.52 + (100 - w.budget) * 0.08));
      return { ttm, cost, resScore };
    }

