    function flyToStation(idx) {
      const cfg = PLANET_COORDS[idx] || PLANET_COORDS[0];
      if (cfg.isGlobe) {
        // Position camera so globe sits clearly visible on the right half while card shrinks
        targetCamPos.set(cfg.x - 1.5, cfg.y + 0.6, cfg.z + 12.2);
        targetLookAt.set(cfg.x - 2.3, cfg.y, cfg.z);
      } else {
        // Position planet gently to the right of the floating cockpit card
        targetCamPos.set(cfg.x - 3.6, cfg.y + 0.8, cfg.z + 11.2);
