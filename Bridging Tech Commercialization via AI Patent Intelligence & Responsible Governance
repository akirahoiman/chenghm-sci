    function latLonToVec3(lat, lon, r) {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lon + 180) * (Math.PI / 180);
      return new THREE.Vector3(
        -r * Math.sin(phi) * Math.cos(theta),
        r * Math.cos(phi),
        r * Math.sin(phi) * Math.sin(theta)
      );
    }

    function buildIPGlobe(group, radius) {
      const oceanGeo = new THREE.SphereGeometry(radius, 48, 48);
      const oceanMat = new THREE.MeshStandardMaterial({
        roughness: 0.55,
        metalness: 0.18,
        transparent: true,
        opacity: 0.94
      });
      const oceanMesh = new THREE.Mesh(oceanGeo, oceanMat);
      oceanMesh.userData.role = 'globe-ocean';
      group.add(oceanMesh);

      // Graticule Rings
      const gratGeo = new THREE.SphereGeometry(radius * 1.008, 24, 16);
      const gratMat = new THREE.MeshBasicMaterial({ wireframe: true, transparent: true, opacity: 0.14 });
      const gratMesh = new THREE.Mesh(gratGeo, gratMat);
      gratMesh.userData.role = 'globe-wire';
      group.add(gratMesh);

      // Country Nodes + Cross-Border Patent Transfer Arcs
      IP_NODES.forEach((node) => {
        const pos = latLonToVec3(node.lat, node.lon, radius * 1.02);
        const pinGeo = new THREE.SphereGeometry(0.14, 16, 16);
        const pinMat = new THREE.MeshBasicMaterial();
        const pin = new THREE.Mesh(pinGeo, pinMat);
        pin.position.copy(pos);
        pin.userData = { role: 'globe-node', nodeData: node };
        group.add(pin);
        ipGlobeNodes.push(pin);

        // Beacon Halo
        const haloGeo = new THREE.RingGeometry(0.19, 0.27, 24);
        const haloMat = new THREE.MeshBasicMaterial({ side: THREE.DoubleSide, transparent: true, opacity: 0.72 });
        const halo = new THREE.Mesh(haloGeo, haloMat);
        halo.position.copy(pos.clone().multiplyScalar(1.01));
        halo.lookAt(pos.clone().multiplyScalar(2));
        halo.userData.role = 'globe-halo';
        group.add(halo);
      });

      // Cross-Border Tech Transfer Arcs
      const pairs = [
        [0, 2], [0, 1], [1, 3], [2, 4], [2, 5], [0, 3], [4, 5]
      ];
      pairs.forEach(([aIdx, bIdx]) => {
        const vA = latLonToVec3(IP_NODES[aIdx].lat, IP_NODES[aIdx].lon, radius * 1.02);
        const vB = latLonToVec3(IP_NODES[bIdx].lat, IP_NODES[bIdx].lon, radius * 1.02);
        const mid = vA.clone().add(vB).multiplyScalar(0.5).normalize().multiplyScalar(radius * 1.38);
        const arcCurve = new THREE.QuadraticBezierCurve3(vA, mid, vB);
        const arcGeo = new THREE.BufferGeometry().setFromPoints(arcCurve.getPoints(36));
        const arcMat = new THREE.LineBasicMaterial({ transparent: true, opacity: 0.78 });
        const arcLine = new THREE.Line(arcGeo, arcMat);
        arcLine.userData.role = 'globe-arc';
        group.add(arcLine);
      });
    }

    function loadWorldTopoJSON() {
      if (typeof topojson === 'undefined' || !ipGlobeGroup) return;
      fetch('https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-110m.json')
        .then(res => res.json())
        .then(topo => {
          const geo = topojson.feature(topo, topo.objects.countries);
          const radius = 4.13;
          const points = [];
          geo.features.forEach((feat) => {
            const geom = feat.geometry;
            if (!geom) return;
            const polys = geom.type === 'Polygon' ? [geom.coordinates] : geom.coordinates;
            polys.forEach((poly) => {
              poly.forEach((ring) => {
                for (let i = 0; i < ring.length - 1; i++) {
                  const p1 = latLonToVec3(ring[i][1], ring[i][0], radius);
                  const p2 = latLonToVec3(ring[i + 1][1], ring[i + 1][0], radius);
                  points.push(p1, p2);
                }
              });
            });
          });
          const lineGeo = new THREE.BufferGeometry().setFromPoints(points);
          const lineMat = new THREE.LineBasicMaterial({
            color: new THREE.Color(getToken('--globe-land', '#88a0b5')),
            transparent: true,
            opacity: 0.78
          });
          const coastLines = new THREE.LineSegments(lineGeo, lineMat);
          coastLines.userData.role = 'globe-coast';
          ipGlobeGroup.add(coastLines);
          worldLandGeo = coastLines;
        })
        .catch(() => {
          // Graceful fallback: wire graticule & country nodes already rendered
        });
    }

