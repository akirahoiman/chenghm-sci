      if (!ctxEl || typeof Chart === 'undefined') return;
      const c1 = getToken('--data-1', '#4b6b88');
      const c2 = getToken('--data-2', '#56726a');
      const textCol = getToken('--on-surface-variant', '#4f6070');
      const gridCol = getToken('--outline-variant', '#cbd5df');

      const pareto = [
        { x: 9.2, y: 58 }, { x: 11.4, y: 69 }, { x: 13.8, y: 79 },
        { x: 16.5, y: 88 }, { x: 19.6, y: 95 }, { x: 22.8, y: 98 }
      ];

      activeChart = new Chart(ctxEl, {
        type: 'scatter',
        data: {
          datasets: [
            {
              label: tx(`NSGA-III 柏拉圖前緣`, `NSGA-III Pareto Front`, `NSGA-III 帕累托前沿`, `NSGA-IIIパレート最適線`, `Pareto-Front`, `Front de Pareto`),
              data: pareto,
              showLine: true,
              borderColor: c2,
              backgroundColor: c2,
              pointRadius: 4,
              borderWidth: 2
            },
            {
              label: tx(`當前最佳解`, `Active Gurobi Solution`, `当前最佳解`, `現在の最適解`, `Aktuelle Lösung`, `Solution active`),
              data: [{ x: parseFloat(orRes.cost), y: orRes.resScore }],
              backgroundColor: c1,
              pointRadius: 9,
              pointHoverRadius: 11
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { labels: { color: textCol } } },
          scales: {
            x: { title: { display: true, text: 'CapEx ($M)', color: textCol }, ticks: { color: textCol }, grid: { color: gridCol } },
            y: { min: 45, max: 100, title: { display: true, text: 'Supply Resilience (%)', color: textCol }, ticks: { color: textCol }, grid: { color: gridCol } }
          }
        }
      });
    }

    function updateORSlider(key, val) {
      appState.orWeights[key === 'resil' ? 'resilience' : key] = Number(val);
      const lbl = document.getElementById(`val-${key}`);
      if (lbl) lbl.textContent = `${val}%`;
      const orRes = computeORMetrics(appState.orWeights);
      const elT = document.getElementById('or-ttm');
      const elC = document.getElementById('or-cost');
      const elR = document.getElementById('or-res');
      if (elT) elT.textContent = `${orRes.ttm} mo`;
      if (elC) elC.textContent = `$${orRes.cost}M`;
      if (elR) elR.textContent = `${orRes.resScore}%`;
      if (activeChart && activeChart.data.datasets[1]) {
        activeChart.data.datasets[1].data = [{ x: parseFloat(orRes.cost), y: orRes.resScore }];
        activeChart.update('none');
      }
      saveState();
    }

    function selectRadarScenario(idx) {
      appState.activeRadarIndex = idx;
      renderStation(2, true);
    }

    function selectCase(idx) {
      appState.activeCaseIndex = idx;
      renderStation(4, true);
    }

    function selectDb(id) {
      appState.activeDb = id;
      renderStation(6, true);
    }

    function focusIPNode(id) {
      const node = IP_NODES.find(n => n.id === id);
      if (!node || !ipGlobeGroup) return;
      // Rotate globe so selected node faces camera
      const targetLonRad = -(node.lon + 90) * (Math.PI / 180);
      ipGlobeGroup.rotation.y = targetLonRad;
      lastFrontNodeId = node.id;
      renderGlobeCallout(node);
    }

    function nextStation() {
      renderStation((appState.station + 1) % 8);
    }

    function prevStation() {
      renderStation((appState.station + 7) % 8);
    }

    function toggleTheme() {
      appState.theme = appState.theme === 'day' ? 'night' : 'day';
      document.documentElement.setAttribute('data-theme', appState.theme === 'night' ? 'night' : '');
      syncThreeThemeColors();
      updateChromeUI();
      renderStation(appState.station, true);
    }

    function changeLanguage(lang) {
      appState.lang = lang;
      document.documentElement.lang = lang;
      updateChromeUI();
      renderStation(appState.station, true);
      if (appState.station === 5 && lastFrontNodeId) {
        const nd = IP_NODES.find(n => n.id === lastFrontNodeId);
        if (nd) renderGlobeCallout(nd);
      }
    }

    function toggleAutoPlay() {
      appState.autoplay = !appState.autoplay;
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
      if (appState.autoplay) {
        autoplayTimer = setInterval(() => {
          nextStation();
        }, 8500);
      }
      updateChromeUI();
      saveState();
    }

    function toggleTTS() {
      appState.tts = !appState.tts;
      if (!appState.tts && window.speechSynthesis) {
        window.speechSynthesis.cancel();
      } else if (appState.tts) {
        speakCurrentStation();
      }
      updateChromeUI();
    }

    function speakCurrentStation() {
      if (!window.speechSynthesis) return;
      window.speechSynthesis.cancel();
      const card = document.getElementById('station-card');
      if (!card) return;
      const titleEl = card.querySelector('.station-title');
      const subEl = card.querySelector('.station-subtitle');
      const text = `${titleEl ? titleEl.textContent : ''}. ${subEl ? subEl.textContent : ''}`;
      const utt = new SpeechSynthesisUtterance(text);
      const pack = I18N[appState.lang] || I18N['zh-TW'];
      utt.lang = pack.ttsLang;
      utt.rate = 1.02;
      window.speechSynthesis.speak(utt);
    }

    function updateChromeUI() {
      const pack = I18N[appState.lang] || I18N['zh-TW'];
      const setTxt = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
      setTxt('ui-kicker', pack.kicker);
      setTxt('ui-brand-title', pack.brandTitle);
      setTxt('ui-autoplay-label', appState.autoplay ? pack.autoplayOn : pack.autoplayOff);
      setTxt('ui-tts-label', appState.tts ? pack.ttsOn : pack.ttsOff);
      setTxt('ui-theme-label', appState.theme === 'night' ? pack.themeNight : pack.themeDay);
      setTxt('ui-prev-label', pack.prev);
      setTxt('ui-next-label', pack.next);
      setTxt('amoeba-bubble', appState.theme === 'night' ? pack.amoebaNight : pack.amoebaDay);
      setTxt('ui-station-counter', `0${appState.station + 1} / 08`);

      const btnAuto = document.getElementById('btn-autoplay');
      if (btnAuto) btnAuto.classList.toggle('active', appState.autoplay);
      const btnTts = document.getElementById('btn-tts');
      if (btnTts) btnTts.classList.toggle('active', appState.tts);

      const prog = document.getElementById('progress-fill');
      if (prog) prog.style.width = `${((appState.station + 1) / 8) * 100}%`;

      const rail = document.getElementById('orbit-rail');
      if (rail) {
        rail.innerHTML = pack.navNames.map((name, i) => `
          <button type="button" class="orbit-btn ${i === appState.station ? 'active' : ''}" onclick="renderStation(${i})">
            <span class="orbit-num">0${i + 1}</span>
            <span class="orbit-label">${name.replace(/^0\d\s*/, '')}</span>
          </button>
        `).join('');
      }
      if (window.lucide) window.lucide.createIcons();
    }

    // =========================================================================
    // 7. STATE PERSISTENCE (GEMINI NOTEBOOK SHIM API) & BOOTSTRAP
    // =========================================================================
    async function saveState() {
      if (window.notebookAppApi && typeof window.notebookAppApi.setAppState === 'function') {
        try {
          await window.notebookAppApi.setAppState({
            station: appState.station,
            lang: appState.lang,
            theme: appState.theme,
            activeRadarIndex: appState.activeRadarIndex,
            activeCaseIndex: appState.activeCaseIndex,
            orWeights: appState.orWeights,
            activeDb: appState.activeDb
          });
        } catch (e) {}
      }
    }

    async function initApp() {
      if (window.notebookAppApi && typeof window.notebookAppApi.getAppState === 'function') {
        try {
          const saved = await window.notebookAppApi.getAppState();
          if (saved) {
            if (typeof saved.station === 'number') appState.station = saved.station;
            if (saved.lang && I18N[saved.lang]) appState.lang = saved.lang;
            if (saved.theme === 'night' || saved.theme === 'day') appState.theme = saved.theme;
            if (typeof saved.activeRadarIndex === 'number') appState.activeRadarIndex = saved.activeRadarIndex;
            if (typeof saved.activeCaseIndex === 'number') appState.activeCaseIndex = saved.activeCaseIndex;
            if (saved.orWeights) appState.orWeights = saved.orWeights;
            if (saved.activeDb) appState.activeDb = saved.activeDb;
          }
        } catch (e) {}
      }

      document.documentElement.lang = appState.lang;
      document.documentElement.setAttribute('data-theme', appState.theme === 'night' ? 'night' : '');
      const langSel = document.getElementById('lang-select');
      if (langSel) langSel.value = appState.lang;

      initThreeSpace();
      initAmoebaCanvas();
      updateChromeUI();
      renderStation(appState.station, true);

      if (window.notebookAppApi && typeof window.notebookAppApi.notifyAppReady === 'function') {
        window.notebookAppApi.notifyAppReady();
      }
    }

    document.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
