    // 4. FLOATING 3D AMOEBA COMPANION (ORGANIC MORPHING BLOB IN CANVAS)
    // =========================================================================
    function initAmoebaCanvas() {
      const canvas = document.getElementById('amoeba-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let t = 0;

      function drawAmoeba() {
        t += 0.045;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const cx = canvas.width / 2;
        const cy = canvas.height / 2;
        const baseR = 46;

        const isNight = appState.theme === 'night';
        const c1 = isNight ? '#72bdd4' : '#6c8dab';
        const c2 = isNight ? '#264d68' : '#43607b';
        const shine = isNight ? 'rgba(220,248,255,0.65)' : 'rgba(255,255,255,0.72)';

        // Organic 3D blob contour
        ctx.beginPath();
        const pts = 48;
        for (let i = 0; i <= pts; i++) {
          const ang = (i / pts) * Math.PI * 2;
          const wobble = Math.sin(ang * 3 + t) * 5.5 + Math.cos(ang * 2 - t * 1.3) * 4.2;
          const r = baseR + wobble;
          const x = cx + Math.cos(ang) * r;
          const y = cy + Math.sin(ang) * r;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();

        const grad = ctx.createRadialGradient(cx - 16, cy - 18, 6, cx, cy, baseR + 12);
        grad.addColorStop(0, shine);
        grad.addColorStop(0.35, c1);
        grad.addColorStop(1, c2);
        ctx.fillStyle = grad;
        ctx.fill();

        // Cute 2000s-style blinking eyes
        const blink = Math.sin(t * 0.45) > 0.96 ? 0.18 : 1;
        const lookX = Math.sin(t * 0.5) * 3;
        [-14, 14].forEach((ox) => {
          ctx.save();
          ctx.translate(cx + ox + lookX, cy - 4);
          ctx.scale(1, blink);
          ctx.beginPath();
          ctx.arc(0, 0, 6.2, 0, Math.PI * 2);
          ctx.fillStyle = '#ffffff';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(1.2, 0.5, 3.2, 0, Math.PI * 2);
          ctx.fillStyle = '#182430';
          ctx.fill();
          ctx.restore();
        });

        // Happy little smile
        ctx.beginPath();
        ctx.arc(cx + lookX, cy + 7, 8, 0.15 * Math.PI, 0.85 * Math.PI);
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2.4;
        ctx.lineCap = 'round';
        ctx.stroke();

        requestAnimationFrame(drawAmoeba);
      }
      drawAmoeba();
    }

