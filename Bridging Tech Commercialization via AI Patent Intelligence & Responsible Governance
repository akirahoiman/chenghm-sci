<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="artifact-type" content="narrative">
  <meta name="design-style" content="haven">
  <title>AI 與專利情報驅動之技術商品化與責任 AI 治理 — 3D 星際智權航行系統</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Hanken+Grotesk:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Sans+TC:wght@400;500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>
  <script src="https://unpkg.com/lucide@1.43.0/dist/umd/lucide.min.js"></script>
  <style>
    :root {
      color-scheme: light;
      /* Bright Morandi Blue (Day Mode Default) */
      --background: #eef2f6;
      --surface-container-low: rgba(255, 255, 255, 0.86);
      --surface-container: #dde5ed;
      --surface-container-high: #cfd9e4;
      --on-surface: #1e2a36;
      --on-surface-variant: #4f6070;
      --outline: #9fb0c0;
      --outline-variant: #cbd5df;
      --primary: #4b6b88;
      --on-primary: #ffffff;
      --primary-container: #dbe6f0;
      --on-primary-container: #243b50;
      --secondary: #56726a;
      --tertiary: #6a8a7e;
      --error: #a64b42;
      --on-error: #ffffff;
      --positive: #3f7a62;
      --warning: #a37438;
      --focus: #4b6b88;

      /* Metallic & Slate Accents + 3D Space Tokens */
      --metallic-sheen: rgba(180, 198, 214, 0.45);
      --glass-backdrop: rgba(247, 250, 253, 0.78);
      --space-fog: #e4ebf2;
      --planet-core: #6d89a3;
      --planet-ring: #96adc2;
      --star-tint: #6c849c;
      --globe-ocean: #d9e4ee;
      --globe-land: #88a0b5;
      --globe-arc: #4b6b88;
      --globe-alert: #b55b52;

      /* Data Series */
      --data-1: #4b6b88;
      --data-2: #56726a;
      --data-3: #9c7b5c;
      --data-4: #7b6e8d;
      --data-context: #b8c5d1;

      /* Typography */
      --font-headline: 'Noto Sans TC', 'Outfit', 'Noto Sans SC', 'Noto Sans JP', sans-serif;
      --font-body: 'Noto Sans TC', 'Hanken Grotesk', 'Noto Sans SC', 'Noto Sans JP', sans-serif;
      --font-label: 'Geist Mono', 'Noto Sans TC', monospace;

      --display-size: clamp(1.85rem, 1.3rem + 2vw, 2.75rem);
      --headline-size: clamp(1.35rem, 1.05rem + 1vw, 1.85rem);
      --subhead-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
      --body-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1rem);
      --label-size: 0.75rem;

      /* Spacing & Radii */
      --space-xs: 0.25rem;
      --space-sm: 0.5rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2.25rem;
      --space-2xl: 3.5rem;
      --rounded: 0.5rem;
      --rounded-lg: 0.875rem;
      --rounded-full: 9999px;

      /* Effects */
      --hairline: 1px solid var(--outline-variant);
      --hairline-control: 1px solid var(--outline);
      --elevation: 0 12px 36px -12px rgba(36, 59, 80, 0.14);
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
      --dur-micro: 140ms;
      --dur-short: 260ms;
      --dur-long: 520ms;
    }

    [data-theme="night"] {
      color-scheme: dark;
      --background: #0a111a;
      --surface-container-low: rgba(17, 27, 40, 0.84);
      --surface-container: #152232;
      --surface-container-high: #1e3045;
      --on-surface: #e8f0f7;
      --on-surface-variant: #9db2c7;
      --outline: #38516b;
      --outline-variant: #23364b;
      --primary: #72bdd4;
      --on-primary: #07131c;
      --primary-container: #183549;
      --on-primary-container: #cdeef8;
      --secondary: #83c4aa;
      --tertiary: #6ca892;
      --error: #e87b72;
      --on-error: #1d0707;
      --positive: #74cfa6;
      --warning: #dfb367;
      --focus: #72bdd4;

      --metallic-sheen: rgba(114, 189, 212, 0.25);
      --glass-backdrop: rgba(13, 22, 34, 0.78);
      --space-fog: #070d14;
      --planet-core: #3c6988;
      --planet-ring: #72bdd4;
      --star-tint: #a9d5e8;
      --globe-ocean: #102030;
      --globe-land: #385b78;
      --globe-arc: #72bdd4;
      --globe-alert: #e87b72;

      --data-1: #72bdd4;
      --data-2: #83c4aa;
      --data-3: #dfb367;
      --data-4: #b99ae0;
      --data-context: #3b536b;
      --elevation: 0 18px 48px -12px rgba(0, 0, 0, 0.55);
    }

    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--background);
      color: var(--on-surface);
      font-family: var(--font-body);
      font-size: var(--body-size);
      line-height: 1.6;
      transition: background-color var(--dur-long) var(--ease-in-out), color var(--dur-short) var(--ease-in-out);
    }

    button, input, select, textarea {
      font-family: inherit;
      color: inherit;
    }

    :focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    /* Fullscreen 3D Space Canvas */
    #space-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      display: block;
    }

    /* Cockpit Atmospheric Vignette */
    .cockpit-vignette {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      background: radial-gradient(circle at 72% 45%, transparent 25%, var(--space-fog) 115%);
      opacity: 0.45;
      transition: opacity var(--dur-long) var(--ease-in-out);
    }

    /* Top Flight HUD Bar */
    .hud-header {
      position: fixed !important;
      top: 0;
      left: 0;
      right: 0;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
      padding: var(--space-sm) var(--space-lg);
      background: var(--glass-backdrop);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: var(--hairline);
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      min-width: 0;
    }

    .brand-emblem {
      width: 34px;
      height: 34px;
      border-radius: var(--rounded);
      background: var(--primary-container);
      border: var(--hairline-control);
      color: var(--primary);
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .brand-titles {
      min-width: 0;
    }

    .brand-kicker {
      font-family: var(--font-label);
      font-size: 0.6875rem;
      color: var(--primary);
      letter-spacing: 0.04em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .brand-name {
      font-family: var(--font-headline);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--on-surface);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .hud-controls {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      flex-wrap: wrap;
    }

    .hud-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 38px;
      padding: 0 var(--space-md);
      border-radius: var(--rounded-full);
      border: var(--hairline-control);
      background: var(--surface-container-low);
      color: var(--on-surface);
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
      transition: background-color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out);
    }

    .hud-btn:hover {
      background: var(--surface-container-high);
      border-color: var(--primary);
    }

    .hud-btn.active {
      background: var(--primary);
      color: var(--on-primary);
      border-color: var(--primary);
    }

    .hud-select {
      min-height: 38px;
      padding: 0 28px 0 12px;
      border-radius: var(--rounded-full);
      border: var(--hairline-control);
      background: var(--surface-container-low);
      color: var(--on-surface);
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
    }

    /* Left Planetary Orbit Rail */
    .orbit-rail {
      position: fixed;
      left: var(--space-lg);
      top: 50%;
      transform: translateY(-50%);
      z-index: 25;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: var(--space-sm);
      background: var(--glass-backdrop);
      backdrop-filter: blur(14px);
      border: var(--hairline);
      border-radius: var(--rounded-lg);
      box-shadow: var(--elevation);
      max-width: 220px;
    }

    .orbit-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      min-height: 40px;
      padding: 6px 10px;
      border-radius: var(--rounded);
      border: 1px solid transparent;
      background: transparent;
      color: var(--on-surface-variant);
      text-align: left;
      font-size: 0.8125rem;
      cursor: pointer;
      transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
    }

    .orbit-btn:hover {
      background: var(--surface-container);
      color: var(--on-surface);
    }

    .orbit-btn.active {
      background: var(--primary-container);
      color: var(--on-primary-container);
      border-color: var(--primary);
      font-weight: 600;
    }

    .orbit-num {
      font-family: var(--font-label);
      font-size: 0.72rem;
      width: 24px;
      height: 24px;
      border-radius: var(--rounded-full);
      display: grid;
      place-items: center;
      background: var(--surface-container);
      color: var(--primary);
      flex-shrink: 0;
    }

    .orbit-btn.active .orbit-num {
      background: var(--primary);
      color: var(--on-primary);
    }

    .orbit-label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Main Interactive Content Viewport */
    .stage-shell {
      position: fixed;
      top: 66px;
      left: 256px;
      right: var(--space-lg);
      bottom: 68px;
      z-index: 15;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      pointer-events: none;
    }

    .station-card {
      pointer-events: auto;
      width: min(860px, 100%);
      max-height: 100%;
      overflow-y: auto;
      padding: var(--space-xl);
      background: var(--glass-backdrop);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: var(--hairline);
      border-top: 2px solid var(--metallic-sheen);
      border-radius: var(--rounded-lg);
      box-shadow: var(--elevation);
      transition: opacity var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
    }

    .station-card.globe-mode {
      width: min(500px, 100%);
    }

    .station-card.transitioning {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }

    .station-header {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-md);
      padding-bottom: var(--space-md);
      border-bottom: var(--hairline);
      margin-bottom: var(--space-lg);
    }

    .station-kicker {
      font-family: var(--font-label);
      font-size: var(--label-size);
      color: var(--primary);
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .station-title {
      font-family: var(--font-headline);
      font-size: var(--headline-size);
      font-weight: 400;
      line-height: 1.18;
      margin: 0;
      color: var(--on-surface);
    }

    .station-title strong {
      font-weight: 600;
      color: var(--primary);
    }

    .station-subtitle {
      margin: 6px 0 0;
      color: var(--secondary);
      font-size: 0.9375rem;
      max-width: 65ch;
    }

    /* Grids & Panels */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md);
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md);
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-sm);
    }

    .panel {
      background: var(--surface-container-low);
      border: var(--hairline);
      border-radius: var(--rounded);
      padding: var(--space-md);
    }

    .panel-highlight {
      background: var(--primary-container);
      border: 1px solid var(--primary);
      border-radius: var(--rounded);
      padding: var(--space-md);
      color: var(--on-primary-container);
    }

    .metric-val {
      font-family: var(--font-headline);
      font-size: 1.65rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      color: var(--primary);
      line-height: 1.15;
    }

    .metric-label {
      font-family: var(--font-label);
      font-size: var(--label-size);
      color: var(--on-surface-variant);
      margin-bottom: 4px;
    }

    .metric-note {
      font-size: 0.8125rem;
      color: var(--secondary);
      margin-top: 4px;
    }

    /* Pipeline Flow */
    .pipeline-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-sm);
      margin: var(--space-md) 0;
    }

    .pipe-step {
      background: var(--surface-container-low);
      border: var(--hairline);
      border-top: 3px solid var(--primary);
      border-radius: var(--rounded);
      padding: var(--space-md);
      cursor: pointer;
      text-align: left;
      transition: background-color var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out);
    }

    .pipe-step:hover {
      background: var(--primary-container);
      transform: translateY(-2px);
    }

    .pipe-idx {
      font-family: var(--font-label);
      font-size: 0.72rem;
      color: var(--primary);
      font-weight: 600;
    }

    .pipe-name {
      font-weight: 600;
      font-size: 0.92rem;
      margin: 4px 0;
      color: var(--on-surface);
    }

    .pipe-desc {
      font-size: 0.8rem;
      color: var(--on-surface-variant);
    }

    /* Controls & Tables */
    .pill-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: var(--space-md);
    }

    .pill-tab {
      min-height: 36px;
      padding: 4px 14px;
      border-radius: var(--rounded-full);
      border: var(--hairline-control);
      background: var(--surface-container-low);
      color: var(--on-surface-variant);
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
      transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
    }

    .pill-tab.active {
      background: var(--primary);
      color: var(--on-primary);
      border-color: var(--primary);
    }

    .chart-box {
      position: relative;
      width: 100%;
      min-height: 260px;
      height: 260px;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.84rem;
    }

    .data-table th {
      font-family: var(--font-label);
      font-size: 0.75rem;
      text-align: left;
      padding: 8px 10px;
      border-bottom: 2px solid var(--outline);
      color: var(--on-surface-variant);
    }

    .data-table td {
      padding: 9px 10px;
      border-bottom: var(--hairline);
      vertical-align: top;
    }

    .data-table tr:hover td {
      background: var(--surface-container);
    }

    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: var(--rounded-full);
      font-family: var(--font-label);
      font-size: 0.72rem;
      font-weight: 600;
    }

    .badge-safe { background: var(--primary-container); color: var(--positive); }
    .badge-warn { background: var(--surface-container); color: var(--warning); }
    .badge-risk { background: var(--surface-container); color: var(--error); border: 1px solid var(--error); }

    .slider-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: var(--space-sm);
    }

    .slider-label-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.8125rem;
      font-weight: 500;
    }

    input[type="range"] {
      width: 100%;
      accent-color: var(--primary);
      cursor: pointer;
    }

    /* Floating Globe Callout Overlay (Right side in Station 6) */
    .globe-hud-overlay {
      position: fixed;
      right: var(--space-lg);
      top: 84px;
      width: min(350px, 34vw);
      z-index: 20;
      pointer-events: none;
      opacity: 0;
      transform: translateX(20px);
      transition: opacity var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
    }

    .globe-hud-overlay.visible {
      opacity: 1;
      transform: translateX(0);
      pointer-events: auto;
    }

    .globe-callout {
      background: var(--glass-backdrop);
      backdrop-filter: blur(16px);
      border: 1px solid var(--primary);
      border-radius: var(--rounded-lg);
      padding: var(--space-md);
      box-shadow: var(--elevation);
    }

    /* Bottom Navigation Bar */
    .hud-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-sm) var(--space-lg);
      background: var(--glass-backdrop);
      backdrop-filter: blur(14px);
      border-top: var(--hairline);
    }

    .progress-track {
      flex: 1;
      max-width: 420px;
      height: 6px;
      background: var(--surface-container);
      border-radius: var(--rounded-full);
      overflow: hidden;
      margin: 0 var(--space-md);
    }

    .progress-fill {
      height: 100%;
      width: 12.5%;
      background: var(--primary);
      border-radius: var(--rounded-full);
      transition: width var(--dur-short) var(--ease-out);
    }

    /* Floating 3D Amoeba Assistant */
    .amoeba-dock {
      position: fixed;
      right: var(--space-lg);
      bottom: 66px;
      z-index: 40;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }

    .amoeba-bubble {
      max-width: 160px;
      padding: 8px 12px;
      background: var(--surface-container-low);
      border: var(--hairline-control);
      border-radius: var(--rounded-lg);
      box-shadow: var(--elevation);
      font-size: 0.78rem;
      color: var(--on-surface);
      line-height: 1.4;
    }

    .amoeba-btn {
      width: 84px;
      height: 84px;
      padding: 0;
      border-radius: var(--rounded-full);
      border: 1px solid var(--outline);
      background: var(--glass-backdrop);
      backdrop-filter: blur(10px);
      box-shadow: var(--elevation);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: transform var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
    }

    .amoeba-btn:hover {
      transform: scale(1.06);
      border-color: var(--primary);
    }

    #amoeba-canvas {
      width: 84px;
      height: 84px;
      display: block;
    }

    .source-footer-note {
      margin-top: var(--space-md);
      padding-top: var(--space-sm);
      border-top: var(--hairline);
      font-size: 0.76rem;
      color: var(--on-surface-variant);
    }

    @media (max-width: 960px) {
      .orbit-rail { display: none; }
      .stage-shell { left: var(--space-md); right: var(--space-md); }
      .globe-hud-overlay { display: none; }
    }

    @media (max-width: 640px) {
      .hud-header { padding: var(--space-xs) var(--space-sm); }
      .brand-kicker { display: none; }
      .stage-shell { top: 60px; left: var(--space-sm); right: var(--space-sm); bottom: 64px; }
      .station-card { padding: var(--space-md); }
      .grid-2, .grid-3, .grid-4, .pipeline-row { grid-template-columns: 1fr; }
      .amoeba-dock { right: var(--space-sm); bottom: 66px; }
      .amoeba-bubble { display: none; }
      .amoeba-btn { width: 64px; height: 64px; }
      #amoeba-canvas { width: 64px; height: 64px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
