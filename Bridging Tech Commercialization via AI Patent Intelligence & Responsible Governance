    function animateSpace() {
      requestAnimationFrame(animateSpace);
      const t = performance.now() * 0.001;

      if (spaceCamera) {
        const desiredCam = targetCamPos.clone().add(new THREE.Vector3(mouseOffset.x, -mouseOffset.y, 0));
        spaceCamera.position.lerp(desiredCam, 0.055);
        currentLookAt.lerp(targetLookAt, 0.065);
        spaceCamera.lookAt(currentLookAt);
      }

      planetGroups.forEach((g, idx) => {
        if (PLANET_COORDS[idx].isGlobe) {
          g.rotation.y += 0.0038;
        } else {
          g.rotation.y += 0.0022;
          g.children.forEach(ch => {
            if (ch.userData && ch.userData.orbitRadius) {
              const a = t * ch.userData.speed + ch.userData.phase;
              ch.position.set(Math.cos(a) * ch.userData.orbitRadius, Math.sin(a * 0.7) * 0.4, Math.sin(a) * ch.userData.orbitRadius);
            }
          });
        }
      });

      if (appState.station === 5 && ipGlobeGroup && spaceCamera) {
        detectFrontIPNode();
      }

      if (spaceRenderer && spaceScene && spaceCamera) {
        spaceRenderer.render(spaceScene, spaceCamera);
      }
    }

    function detectFrontIPNode() {
      let bestNode = null;
      let bestZ = -Infinity;
      const worldPos = new THREE.Vector3();
      ipGlobeNodes.forEach(pin => {
        pin.getWorldPosition(worldPos);
        const rel = worldPos.clone().sub(ipGlobeGroup.position);
        // Closest to camera (+Z relative to globe center)
        const camDir = spaceCamera.position.clone().sub(ipGlobeGroup.position).normalize();
        const dot = rel.dot(camDir);
        if (dot > bestZ) {
          bestZ = dot;
          bestNode = pin.userData.nodeData;
        }
      });
      if (bestNode && bestNode.id !== lastFrontNodeId) {
        lastFrontNodeId = bestNode.id;
        renderGlobeCallout(bestNode);
      }
    }

